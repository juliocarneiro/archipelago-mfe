{
  "name": "archipelago",
  "private": true,
  "type": "module",
  "description": "Production-minded micro frontend boilerplate: Module Federation 2.0, Rsbuild, React 19, TypeScript, Tailwind v4, Turborepo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliocarneiro/archipelago-mfe.git"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=20",
    "build": "turbo run build",
    "preview": "turbo run preview --concurrency=20",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --project=chromium",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "screenshots": "playwright test --project=screenshots",
    "init:project": "node scripts/init-project.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
